# .env.production.example — Veklom BYOS Backend
# Copy to .env.production and fill in ALL values before deploying.
# NEVER commit this file with real values.

# ── Core ─────────────────────────────────────────────────────────────────────
APP_NAME=Veklom Sovereign AI Hub
VERSION=1.0.0
APP_ENV=production
PORT=80
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/app/logs/veklom.log
CORS_ORIGINS=https://veklom.com,https://www.veklom.com,https://app.veklom.com
ALLOWED_HOSTS=veklom.com,www.veklom.com,app.veklom.com,localhost,127.0.0.1
MAX_WORKERS=4
FRONTEND_URL=https://veklom.com
API_URL=https://veklom.com
ADMIN_EMAIL=founder@veklom.com
VEKLOM_API_BASE=/api/v1

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_SECURE_SECRET_KEY
AI_CITIZENSHIP_SECRET=REPLACE_WITH_AI_CITIZENSHIP_SECRET
ENCRYPTION_KEY=REPLACE_WITH_ENCRYPTION_KEY
ENABLE_MFA=true
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
SESSION_TIMEOUT_MINUTES=120

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=veklom_production
POSTGRES_USER=veklom_user
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DATABASE_URL=postgresql+asyncpg://veklom_user:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/veklom_production

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/1

# ── AI Providers ─────────────────────────────────────────────────────────────
DEFAULT_AI_PROVIDER=openai
AI_PROVIDER=ollama/groq/huggingface/gemini/openai
LLM_PROVIDER=ollama
AI_FALLBACK_PROVIDER=groq
OPENAI_API_KEY=NEED_FROM_OPENAI
ANTHROPIC_API_KEY=sk-ant-YOUR_PRODUCTION_ANTHROPIC_KEY
GEMINI_API_KEY=NEED_FROM_GEMINI
GEMINI_MODEL=gemini-2.5-flash
HUGGINGFACE_API_KEY=NEED_FROM_HUGGINGFACE
HF_TOKEN=NEED_FROM_HUGGINGFACE
HF_API_URL=https://router.huggingface.co/v1
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:fastest
GROQ_API_KEY=NEED_FROM_GROQ
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
SERPAPI_KEY=NEED_FROM_SERPAPI
# Same Docker network: http://veklom-ollama:11434
# Separate Ollama server: http://YOUR_OLLAMA_SERVER_PRIVATE_IP:11434
OLLAMA_BASE_URL=http://veklom-ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_AUTOSTART=true
OLLAMA_PULL_ON_BOOT=false
OLLAMA_STARTUP_TIMEOUT_MS=120000
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# VLLM_BASE_URL=http://your-vllm-host:8080

# ── Stripe (Billing) ─────────────────────────────────────────────────────────
# Use sk_live_... for production
STRIPE_SECRET_KEY=NEED_FROM_STRIPE
STRIPE_PUBLISHABLE_KEY=NEED_FROM_STRIPE
STRIPE_WEBHOOK_SECRET=NEED_FROM_STRIPE

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_WORKER_KEY=REPLACE_WITH_RESEND_WORKER_KEY
RESEND_SMTP_KEY=REPLACE_WITH_RESEND_SMTP_KEY
RESEND_VERCEL_KEY=REPLACE_WITH_RESEND_VERCEL_KEY
EMAIL_FROM=Veklom <hello@mail.veklom.com>
RESEND_WEBHOOK_URL=https://veklom.com/api/v1/webhooks/resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_PORT_TLS=2465
SMTP_USER=resend
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD

# ── Storage (S3 / MinIO) ──────────────────────────────────────────────────────
S3_ENDPOINT_URL=https://your-minio-or-s3-endpoint
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
S3_BUCKET_NAME=veklom-prod-uploads
S3_REGION=us-east-1

# ── License ───────────────────────────────────────────────────────────────────
LICENSE_KEY=VKLM-XXXX-XXXX-XXXX-XXXX
LICENSE_SERVER_URL=https://license.veklom.com
PACKAGE_GUARD_ENABLED=true

# ── Observability (Sentry) ───────────────────────────────────────────────────
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/project
SENTRY_ENVIRONMENT=production
SENTRY_ORG=veklom-sovereign-ai-hub-p0
SENTRY_PROJECT=veklom

# ── Observability (Grafana Cloud) ─────────────────────────────────────────────
GRAFANA_INSTANCE_ID=YOUR_GRAFANA_INSTANCE_ID
GRAFANA_API_TOKEN=YOUR_GRAFANA_API_TOKEN
PROMETHEUS_API_TOKEN=YOUR_PROMETHEUS_API_TOKEN
PROMETHEUS_REMOTE_WRITE_URL=https://prometheus-prod-32-prod-ca-east-0.grafana.net/api/prom/push
PROMETHEUS_USERNAME=YOUR_PROMETHEUS_USERNAME
PROMETHEUS_PASSWORD=YOUR_PROMETHEUS_PASSWORD
LOKI_URL=https://logs-prod-018.grafana.net
LOKI_USERNAME=YOUR_LOKI_USERNAME
LOKI_PASSWORD=YOUR_LOKI_PASSWORD
ALERTMANAGER_URL=https://alertmanager-prod-ca-east-0.grafana.net
ALERTMANAGER_USERNAME=YOUR_ALERTMANAGER_USERNAME
ALERTMANAGER_PASSWORD=YOUR_ALERTMANAGER_PASSWORD
PYROSCOPE_URL=https://profiles-prod-006.grafana.net
PYROSCOPE_USERNAME=YOUR_PYROSCOPE_USERNAME
PYROSCOPE_PASSWORD=YOUR_PYROSCOPE_PASSWORD
SIGIL_ENDPOINT=https://sigil-prod-ca-east-0.grafana.net
SIGIL_INSTANCE_ID=YOUR_SIGIL_INSTANCE_ID
SIGIL_API_TOKEN=YOUR_SIGIL_API_TOKEN
OTEL_SERVICE_NAME=veklom-sovereign-ai-hub
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ca-east-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=NEED_FROM_GRAFANA
ALLOY_REMOTE_WRITE_URL=https://prometheus-prod-32-prod-ca-east-0.grafana.net/api/prom/push

# ── Async Jobs ────────────────────────────────────────────────────────────────
QSTASH_TOKEN=YOUR_QSTASH_TOKEN
QSTASH_CURRENT_SIGNING_KEY=YOUR_SIGNING_KEY
QSTASH_NEXT_SIGNING_KEY=YOUR_NEXT_SIGNING_KEY

# ── Performance Tuning ─────────────────────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_AI_REQUESTS=10
AI_REQUEST_TIMEOUT_SECONDS=60
MODEL_CACHE_DIR=/app/models

# ── Server Configuration ───────────────────────────────────────────────────────
SERVER_IP=YOUR_SERVER_IP

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=NEED_FROM_SLACK
