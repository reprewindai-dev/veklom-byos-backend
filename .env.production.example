# .env.production.example — Veklom BYOS Backend
# Copy to .env.production and fill in ALL values before deploying.
# NEVER commit this file with real values.

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=production
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=https://app.yourdomain.com
MAX_WORKERS=4

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:strongpassword@your-db-host:5432/veklom_prod

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://your-redis-host:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI Providers ─────────────────────────────────────────────────────────────
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=sk-YOUR_PRODUCTION_OPENAI_KEY
ANTHROPIC_API_KEY=sk-ant-YOUR_PRODUCTION_ANTHROPIC_KEY
# OLLAMA_BASE_URL=http://your-ollama-host:11434
# VLLM_BASE_URL=http://your-vllm-host:8080

# ── Stripe (Billing) ─────────────────────────────────────────────────────────
# Use sk_live_... for production
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_STRIPE_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_PRODUCTION_WEBHOOK_SECRET

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_PRODUCTION_RESEND_KEY
FROM_EMAIL=noreply@yourdomain.com

# ── Storage (S3 / MinIO) ──────────────────────────────────────────────────────
S3_ENDPOINT_URL=https://your-minio-or-s3-endpoint
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
S3_BUCKET_NAME=veklom-prod-uploads
S3_REGION=us-east-1

# ── License ───────────────────────────────────────────────────────────────────
LICENSE_KEY=VKLM-XXXX-XXXX-XXXX-XXXX
LICENSE_SERVER_URL=https://license.veklom.com
PACKAGE_GUARD_ENABLED=true

# ── Async Jobs ────────────────────────────────────────────────────────────────
QSTASH_TOKEN=YOUR_QSTASH_TOKEN
QSTASH_CURRENT_SIGNING_KEY=YOUR_SIGNING_KEY
QSTASH_NEXT_SIGNING_KEY=YOUR_NEXT_SIGNING_KEY

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
