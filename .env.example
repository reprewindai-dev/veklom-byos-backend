# BYOS AI Backend - Environment Variables
# Copy to .env and fill in your values.

# ── Required — App ────────────────────────────────────────────────────────────
SECRET_KEY=
ENCRYPTION_KEY=
DATABASE_URL=postgresql://byos:password@postgres:5432/byos_ai
REDIS_URL=redis://localhost:6379/0

# ── LLM Engine ────────────────────────────────────────────────────────────────
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL_DEFAULT=qwen2.5:3b
LLM_FALLBACK=groq
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048

# ── External AI Providers (Optional) ──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_WHISPER=whisper-1
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL_CHAT=mistralai/Mistral-7B-Instruct-v0.1
HUGGINGFACE_MODEL_EMBED=sentence-transformers/all-MiniLM-L6-v2

# ── Circuit Breaker ───────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ── Conversation Memory ───────────────────────────────────────────────────────
MEMORY_TTL_SECONDS=86400
MEMORY_MAX_MESSAGES=20

# ── Security ──────────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_FAILED_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_MINUTES=30

# ── Content Safety ────────────────────────────────────────────────────────────
CONTENT_FILTERING_ENABLED=true
AGE_VERIFICATION_REQUIRED=false

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Infrastructure ────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=byos-ai
CELERY_BROKER_URL=redis://localhost:6379/0
CORS_ORIGINS=[]

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_FORMAT=json
METRICS_ENABLED=true
GRAFANA_USER=admin
GRAFANA_PASSWORD=
