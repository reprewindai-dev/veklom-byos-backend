# Coinbase Developer Platform credentials
# Create a CDP project at: https://cdp.coinbase.com
# Then generate an API key under "API Keys"
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

# Your Base wallet address to receive USDC payments
# This is the PUBLIC address — you do NOT need to put the private key here
# Get a wallet from: https://wallet.coinbase.com or any EVM wallet (MetaMask, etc.)
PAY_TO=0xYourReceivingWalletAddress

# The existing Veklom FastAPI backend (private — not exposed to agents)
# On the Docker coolify network, the backend container is reachable by name
UPSTREAM_BASE_URL=http://n13gp1nhrcdp0hvazvbnlxru-213557155694:8088

# Secret that the gateway injects into upstream requests
# The FastAPI backend should reject requests missing this header
# Generate: openssl rand -hex 32
UPSTREAM_GATEWAY_SECRET=generate-a-strong-random-secret-here

# Network and port
NETWORK=eip155:8453
PORT=3001
NODE_ENV=production
