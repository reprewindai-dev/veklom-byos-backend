# Veklom Workspace — environment template.
# Copy to .env.local for local development, or set in Cloudflare Pages.

# Base URL of your veklom-byos-backend deployment.
#   Production: https://api.veklom.com
#   Local:      http://localhost:8000
# If left blank, the dashboard runs in "demo mode" with empty states and a banner.
VITE_VEKLOM_API_BASE=

# Optional UI label for the active workspace (purely cosmetic in the topbar).
VITE_WORKSPACE_LABEL=
