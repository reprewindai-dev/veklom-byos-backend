{
  "name": "veklom-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Full-stack frontend for veklom-byos-backend. Multi-file source, builds to static/workspace which FastAPI mounts at /workspace.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
