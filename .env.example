# .env.example — Veklom BYOS Backend
# Copy to .env and fill in your values.
# NEVER commit real secrets to version control.

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL async connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/veklom

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI Providers ─────────────────────────────────────────────────────────────
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
HUGGINGFACE_API_KEY=hf_YOUR_HUGGINGFACE_KEY_HERE

# Optional: private runtimes
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral
# VLLM_BASE_URL=http://localhost:8080

# ── Stripe (Billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_RESEND_KEY_HERE
FROM_EMAIL=noreply@yourdomain.com

# ── Storage (S3 / MinIO) ──────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=veklom-uploads
S3_REGION=us-east-1

# ── License ───────────────────────────────────────────────────────────────────
# LICENSE_KEY=VKLM-XXXX-XXXX-XXXX-XXXX
# LICENSE_SERVER_URL=https://license.veklom.com
PACKAGE_GUARD_ENABLED=false

# ── Async Jobs (Optional) ─────────────────────────────────────────────────────
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# ── Monitoring (Optional) ─────────────────────────────────────────────────────
# SENTRY_DSN=
