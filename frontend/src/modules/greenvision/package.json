    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.38.0",
