# .env.example — Veklom BYOS Backend
# Copy to .env and fill in your values.
# NEVER commit real secrets to version control.

# ── Core ─────────────────────────────────────────────────────────────────────
APP_NAME=Veklom Sovereign AI Hub
VERSION=1.0.0
APP_ENV=development
PORT=8088
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/app/logs/veklom.log
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://veklom.com,https://www.veklom.com,https://app.veklom.com
ALLOWED_HOSTS=veklom.com,www.veklom.com,app.veklom.com,localhost,127.0.0.1
MAX_WORKERS=4
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8088
ADMIN_EMAIL=founder@veklom.com
VEKLOM_API_BASE=/api/v1

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
AI_CITIZENSHIP_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ENABLE_MFA=true
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
SESSION_TIMEOUT_MINUTES=120

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL async connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/veklom
POSTGRES_DB=veklom
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI Providers ─────────────────────────────────────────────────────────────
DEFAULT_AI_PROVIDER=ollama
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
HUGGINGFACE_API_KEY=hf_YOUR_HUGGINGFACE_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
SERPAPI_KEY=YOUR_SERPAPI_KEY_HERE

# Ollama (default local provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional: private runtimes
# VLLM_BASE_URL=http://localhost:8080

# ── Stripe (Billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_RESEND_KEY_HERE
RESEND_WORKER_KEY=YOUR_RESEND_WORKER_KEY_HERE
RESEND_SMTP_KEY=YOUR_RESEND_SMTP_KEY_HERE
RESEND_VERCEL_KEY=YOUR_RESEND_VERCEL_KEY_HERE
EMAIL_FROM=Veklom <noreply@veklom.com>
RESEND_WEBHOOK_URL=https://veklom.com/api/v1/webhooks/resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_PORT_TLS=2465
SMTP_USER=resend
SMTP_PASSWORD=YOUR_SMTP_PASSWORD

# ── Storage (S3 / MinIO) ──────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=veklom-uploads
S3_REGION=us-east-1

# ── License ───────────────────────────────────────────────────────────────────
LICENSE_KEY=YOUR_LICENSE_KEY
LICENSE_SERVER_URL=https://license.veklom.com
PACKAGE_GUARD_ENABLED=true

# ── Observability (Sentry) ───────────────────────────────────────────────────
SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_ENVIRONMENT=development
SENTRY_ORG=veklom-sovereign-ai-hub-p0
SENTRY_PROJECT=veklom

# ── Performance Tuning ───────────────────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_AI_REQUESTS=10
AI_REQUEST_TIMEOUT_SECONDS=60
MODEL_CACHE_DIR=/app/models

# ── Server Configuration ─────────────────────────────────────────────────────
SERVER_IP=YOUR_SERVER_IP

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL

# ── Async Jobs (Optional) ─────────────────────────────────────────────────────
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# ── Monitoring (Optional) ─────────────────────────────────────────────────────
# GRAFANA_INSTANCE_ID=
# GRAFANA_API_TOKEN=
# PROMETHEUS_API_TOKEN=
# PROMETHEUS_REMOTE_WRITE_URL=
# PROMETHEUS_USERNAME=
# PROMETHEUS_PASSWORD=
# LOKI_URL=
# LOKI_USERNAME=
# LOKI_PASSWORD=
# ALERTMANAGER_URL=
# ALERTMANAGER_USERNAME=
# ALERTMANAGER_PASSWORD=
# PYROSCOPE_URL=
# PYROSCOPE_USERNAME=
# PYROSCOPE_PASSWORD=
# SIGIL_ENDPOINT=
# SIGIL_INSTANCE_ID=
# SIGIL_API_TOKEN=
# OTEL_SERVICE_NAME=veklom-sovereign-ai-hub
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# ALLOY_REMOTE_WRITE_URL=
